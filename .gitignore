# ReTripper - Git Ignore File
# This file excludes build artifacts and generated files from version control.

# macOS Files
.DS_Store
.AppleDouble
.LSOverride
.*
.Spotlight-V100
.Trashes
.Efuss

# Xcode Derived Data and Build Artifacts
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.statev3
*.xccheckout
*.xcuserdata/**
build/
*.build/
*.derivedData/
*.xcuserdata/

# Swift Package Manager Build Artifacts
Pods/
*.swiftpm/
*.build/
.swift-doc/
.swiftmodule/
*.xccopydone
*.xcoutputdump

# Environment and Local Configuration Secrets
.env
.env.local
.env.*.local
*.env
secrets.json
credentials.json
config.production.json
config.development.json
*.pem
*.key
*.p12
*.mobileprovision
*.cer
*.cert
*.jks
*.keystore

# Private Signing Files and Certificates
*.p8
*.pfx
*.pkcs12
*.mobileprovision
*.cer
*.key
*.privateKey
*.publicKey
*.pem
*.crt
*.der
*.asc
*.md5
*.sha1
*.sha256

# Provisioning Profiles and Credentials
*.provisionprofile
*.provisioning_profile
*.plist
*.xcodeproj/xcshareddata/xcsigningcredentials.plist
*.xcsigningcredentials.plist

# Temporary Files and Logs
*.tmp
*.temp
*.swp
*.swo
*~
*.log
*.out
*.build.log
*.error.log
*.debug.log
*.trace
*.pid
*.sock

# IDE and Editor Specific
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swiftpm-xcworkspace
*.xcworkspace


# Local backup of the earlier uncommitted Phase 3 draft (not compiled, not committed)
_Phase3DraftBackup/

# Local secrets (Google Maps / Spotify keys)
Config/Secrets.xcconfig
