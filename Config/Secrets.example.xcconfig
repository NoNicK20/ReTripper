// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your own values.
// Never commit the real file.
//
// Google Maps Navigation SDK key: create it in a Google Cloud project with billing
// enabled and the "Navigation SDK" API enabled, and restrict it to the iOS bundle
// identifier com.nonick20.retripper. The key is embedded in the app binary (this is
// how Google's iOS SDKs work), so the bundle restriction is what protects it.
GOOGLE_MAPS_API_KEY = your-google-maps-api-key

// Spotify developer client ID (only needed once the Spotify iOS SDK is integrated).
SPOTIFY_CLIENT_ID =
