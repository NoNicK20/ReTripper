// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your own values.
// Never commit the real file. See GOOGLE_MAPS_SETUP.md for how to create the key.
//
// The same key is used by the Maps SDK, Navigation SDK and Places SDK. Restrict it to
// the iOS app com.nonick20.retripper and to those three APIs only.
GOOGLE_MAPS_API_KEY = your-google-maps-api-key

// Spotify developer client ID (only needed once the Spotify iOS SDK is integrated).
SPOTIFY_CLIENT_ID =
