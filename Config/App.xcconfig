// App.xcconfig — shared build settings (committed).
// Credentials are NEVER stored here. The Google Maps API key comes from:
//   - Config/Secrets.xcconfig on your own Mac (git-ignored; copy Secrets.example.xcconfig), or
//   - the GOOGLE_MAPS_API_KEY secret in GitHub Actions, which writes Secrets.xcconfig at build time.
// Without a key the app builds, but shows "Google Maps is not configured" instead of a map.

GOOGLE_MAPS_API_KEY =

// Spotify Client ID is a PUBLIC app identifier (it ships inside every Spotify
// app build and is safe to commit — it is NOT a secret, unlike a client secret
// or the Google Maps key above). Paired with the redirect URI
// retripper://spotify-callback registered on the Spotify developer dashboard.
SPOTIFY_CLIENT_ID = dabfe8cd488a4622979b5fa5165a1465

#include? "Secrets.xcconfig"
